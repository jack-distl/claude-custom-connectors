PORT=3000

# Data API key — used for keyword research, domain analysis, backlinks data.
# Get it from SE Ranking → Profile → API → Data API Key.
SE_RANKING_DATA_API_KEY=

# Project (System) API key — used for project management, rank tracking,
# audits, competitor tracking, account management.
# Get it from SE Ranking → Profile → API → Project/System Key.
SE_RANKING_PROJECT_API_KEY=
