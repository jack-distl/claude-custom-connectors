# Port (Railway sets this automatically)
PORT=3000

# Public URL of this connector (REQUIRED for OAuth callbacks)
# After deploying to Railway, generate a domain and set this to the full URL
# e.g., https://xero-connector-production-xxxx.up.railway.app
# The Xero app's redirect URI must be this URL + /oauth/callback
SERVER_URL=

# OAuth credentials from your Xero app (developer.xero.com → My Apps)
CLIENT_ID=
CLIENT_SECRET=

# Who is allowed to sign in (comma-separated). REQUIRED — if empty, nobody can.
# Must match the email of the Xero login used to connect.
ALLOWED_EMAILS=

# Optional: pin the Xero organisation. Only needed if the connected login
# authorises more than one organisation. Leave blank to auto-detect.
XERO_TENANT_ID=

# Optional: override the OAuth scopes (space-separated) if Xero rejects one.
# Leave blank to use the defaults in src/index.ts.
XERO_SCOPES=
