# Port (Railway sets this automatically)
PORT=3000

# Public URL of this connector (REQUIRED for OAuth callbacks)
# After deploying to Railway, generate a domain and set this to the full URL
# e.g., https://xero-connector-production-xxxx.up.railway.app
# The Xero app's redirect URI must be this URL + /oauth/callback
SERVER_URL=

# OAuth credentials from your Xero app (developer.xero.com → My Apps)
CLIENT_ID=
CLIENT_SECRET=

# Who can sign in at all. At least one is REQUIRED, or nobody can.
# Matching either lets someone in. Checked at sign-in and on every call.
ALLOWED_EMAIL_DOMAINS=distl.com.au
ALLOWED_EMAILS=

# REQUIRED: the Xero organisation the connector is locked to. Every call is
# refused while this is blank, and anyone whose Xero login isn't connected to
# this org is refused. To find it, deploy with this blank, connect in Claude and
# run my_access: the refusal lists your connected organisations and their IDs.
XERO_TENANT_ID=

# Which parts of the connector each person can use (comma-separated emails,
# or * for everyone who can sign in). Blank = nobody. Xero's own role still
# applies on top: these can only take access away, never add it.
#   accounting = contacts, invoices, bills, bank transactions, software spend
#   reports    = P&L, balance sheet and other reports
#   leave      = employee list, leave types, leave applications, leave by day
#   payroll    = pay runs, payslips, payroll timesheets, full employee records
#                (payroll includes leave)
ACCESS_ACCOUNTING=*
ACCESS_REPORTS=
ACCESS_LEAVE=
ACCESS_PAYROLL=

# Optional: override the OAuth scopes (space-separated) if Xero rejects one.
# Leave blank to use the defaults in src/index.ts.
XERO_SCOPES=
