# Port (Railway sets this automatically)
PORT=3000

# Public URL of this connector (REQUIRED for OAuth callbacks)
# After deploying to Railway, generate a domain and set this to the full URL
# e.g., https://workflowmax-connector-production-xxxx.up.railway.app
SERVER_URL=

# OAuth credentials from WorkflowMax by BlueRock
# Get these from your WorkflowMax developer/OAuth app settings
CLIENT_ID=
CLIENT_SECRET=

# WorkflowMax Organisation ID (REQUIRED)
# Find it in WorkflowMax → Settings → Organisation Settings (visible in the URL)
# e.g., https://app.workflowmax.com/organizations/{THIS_ID}/settings/general/organisation_settings
WFM_ACCOUNT_ID=
